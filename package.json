{
  "name": "dsh-theme-shelter",
  "version": "0.3.1",
  "description": "Immersive weather ambience for the DeepSeek Harness Web GUI: physical rain with splashes, snow crystals with habits, a hearth, procedural snow wind and recorded rain/fire. 沉浸式天气主题：物理化的雨与水花、带晶型的雪、炉火、真实录音与程序化风声。",
  "icon": "assets/logo.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "rain"
  ],
  "author": "ifer47",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifer47/dsh-theme-shelter.git"
  },
  "homepage": "https://github.com/ifer47/dsh-theme-shelter",
  "bugs": {
    "url": "https://github.com/ifer47/dsh-theme-shelter/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "assets",
    "lib",
    "client",
    "audio",
    "preview",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README_zh.md"
  ]
}
